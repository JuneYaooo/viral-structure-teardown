  "block_count": 14,
  "blocks": [
    {
      "i": 0,
      "start": 0.0,
      "end": 6.0,
      "text": "你以为早起就能变自律？"
    },
    {
      "i": 1,
      "start": 6.0,
      "end": 6.0,
      "text": "错了。"
    },
    {
      "i": 2,
      "start": 6.0,
      "end": 6.0,
      "text": "我坚持五点起床一年，反而越来越累。"
    },
    {
      "i": 3,
      "start": 6.0,
      "end": 14.0,
      "text": "后来我才发现，问题不在几点起。"
    },
    {
      "i": 4,
      "start": 14.0,
      "end": 14.0,
      "text": "在于起来之后的第一个小时干什么。"
    },
    {
      "i": 5,
      "start": 14.0,
      "end": 14.0,
      "text": "我把它分成了三段。"
    },
    {
      "i": 6,
      "start": 14.0,
      "end": 22.0,
      "text": "前二十分钟只喝水和拉伸，不碰手机。"
    },
    {
      "i": 7,
      "start": 22.0,
      "end": 22.0,
      "text": "中间二十分钟写当天最重要的一件事。"
    },
    {
      "i": 8,
      "start": 22.0,
      "end": 30.0,
      "text": "最后二十分钟读书。"
    },
    {
      "i": 9,
      "start": 30.0,
      "end": 30.0,
      "text": "听起来很普通对吧？"
    },
    {
      "i": 10,
      "start": 30.0,
      "end": 30.0,
      "text": "但真正改变我的，是第二段。"
    },
    {
      "i": 11,
      "start": 30.0,
      "end": 36.0,
      "text": "因为写下来的那件事，我当天完成率从三成涨到了八成。"
    },
    {
      "i": 12,
      "start": 36.0,
      "end": 40.0,
      "text": "三段式时间表我放评论区了。"
    },
    {
      "i": 13,
      "start": 40.0,
      "end": 40.0,
      "text": "明天见。"
    }
  ]
}
